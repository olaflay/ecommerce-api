{
  "name": "task2-background-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "Background Jobs Done Properly - Queue, Worker, Dead-Letter, and Concurrency Engine",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev:api": "tsx watch src/api/server.ts",
    "worker": "tsx src/worker/runner.ts",
    "start": "tsx src/api/server.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:test:deploy": "node scripts/test-db.mjs deploy",
    "db:test:reset": "node scripts/test-db.mjs reset",
    "test": "vitest run",
    "test:break-it": "vitest run tests/break-it.test.ts",
    "test:api": "vitest run tests/api-contract.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
