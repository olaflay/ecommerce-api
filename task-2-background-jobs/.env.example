# ---------------------------------------------------------------------------
# PostgreSQL connection string.
#
# Local dev (no SSL):
#   postgresql://postgres:postgres@localhost:5432/bootcamp_jobs?connection_limit=10
#
# Managed Postgres (Render / Railway) REQUIRES the sslmode param:
#   postgresql://user:pass@host:5432/db?sslmode=require&connection_limit=10
#
# The same value is validated by src/config/index.ts and used to construct the
# Prisma client. A missing/empty value aborts the process at startup.
DATABASE_URL=

# HTTP port for the Express API and the dashboard.
PORT=5000

# production | development | test
NODE_ENV=development

# Maximum jobs a single worker PROCESS runs at once. Per-process, not global:
# see "Limitations" in README.md.
WORKER_CONCURRENCY=5

# Default retry budget for a newly enqueued job.
MAX_ATTEMPTS=3

# Exponential backoff: base * 2^(attempts-1) + random(0, MAX_JITTER_MS).
BASE_BACKOFF_MS=1000
MAX_JITTER_MS=500

# A job in `processing` whose last heartbeat is older than this is recovered by
# the sweeper. MUST be greater than HEARTBEAT_INTERVAL_MS - the config module
# refuses to boot otherwise, because a heartbeat that fires less often than the
# timeout guarantees every job is falsely declared stuck.
STUCK_JOB_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_MS=10000

# How often a worker polls for claimable work, and how often the sweeper runs.
POLL_INTERVAL_MS=500
SWEEP_INTERVAL_MS=10000

# How many stuck rows a single sweeper pass recovers.
SWEEPER_BATCH_SIZE=50

# Truncation ceiling for the `lastError` column (message + stack).
MAX_ERROR_CHARS=4000

# Request body ceiling accepted by express.json().
BODY_LIMIT=100kb

# Comma-separated explicit CORS allowlist. Never use *. An empty value means no
# browser origin is allowed (curl and server-to-server calls still work).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# ---------------------------------------------------------------------------
# Test-only. `npm test` runs against an isolated Postgres schema so a test run
# never mutates the `public` schema. TEST_DATABASE_URL defaults to DATABASE_URL.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=
TEST_DB_SCHEMA=task2_test
