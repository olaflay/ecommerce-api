# Dependencies
node_modules/

# Build output
dist/
build/
storefront-consumer-dist/

# Secrets. Never commit a real .env; commit only .env.example.
.env
.env.*.local
!.env.example

# Test + tooling output
coverage/
*.tsbuildinfo

# Agent / browser scratch captures. These are machine-local session artifacts,
# not deliverables. Note the anchored path: an unanchored rule here would also
# swallow the committed reviews/ and evidence/ directories.
.playwright-mcp/
.tmp/
tmp/

# Editor + OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs. Evidence harnesses write real logs that ARE deliverables, so those are
# re-included below rather than blanket-ignored.
*.log
!task-1-consumable-api/evidence/*.log
!task-2-background-jobs/evidence/*.log
!task-3-api-data-modeling/evidence/*.log
!task-5-pseudocoding/evidence/*.log
