# PostgreSQL connection string.
# Local dev (no SSL): postgres://postgres:postgres@localhost:5432/bootcamp_ecommerce?connection_limit=5
# Managed Postgres (Render/Railway) REQUIRES the sslmode param:
#   postgresql://user:pass@host:5432/db?sslmode=require&connection_limit=5
DATABASE_URL=

# HTTP port for the Express server.
PORT=4000

# production | development | test
NODE_ENV=development

# Comma-separated explicit CORS allowlist. Never use *.
# Example: http://localhost:5173,https://my-consumer.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Rate limiting window (ms) and max requests per IP per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100