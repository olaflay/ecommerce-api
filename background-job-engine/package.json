{
  "name": "task2-background-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "Background Jobs Done Properly - Queue, Worker, Dead-Letter, and Concurrency Engine",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "worker": "tsx src/worker/runner.ts",
